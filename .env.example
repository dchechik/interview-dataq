# Storage backend for dataset versions.
#   parquet  immutable Parquet parts under $DATAQ_DATA_DIR/lake  (default)
#            free checkpoints, resumable jobs, portable to S3
#   duckdb   tables inside one warehouse.duckdb -- easiest to host remotely,
#            but DuckDB is single-writer, so no out-of-process job workers
DATAQ_STORAGE=parquet

# All state (catalog, lake, warehouse) lives under here. Mount one volume.
DATAQ_DATA_DIR=./data

# DuckDB runtime limits.
DATAQ_DUCKDB_MEMORY_LIMIT=4GB
DATAQ_DUCKDB_THREADS=4

# Job execution.
DATAQ_JOB_WORKERS=2
DATAQ_BATCH_ROWS=100000
DATAQ_CHECKPOINT_EVERY_BATCHES=5

# Directories the file browser may list, colon-separated. Browsing is confined to
# these, so a hosted deployment cannot be walked from the UI. Unset means your home
# directory plus the working directory, which is right when the server is your laptop.
# DATAQ_BROWSE_ROOTS=/srv/data:/mnt/datasets

# Cap on files uploaded through the browser. Files already on the server are read
# in place by DuckDB and are not subject to this.
DATAQ_MAX_UPLOAD_MB=2048

# Access control. Leave unset on a laptop nobody else can reach. On a hosted
# instance set both: REQUIRE_AUTH makes the app refuse to start without a token,
# so it cannot end up on a public URL wide open.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DATAQ_AUTH_TOKEN=
# DATAQ_REQUIRE_AUTH=false

# Whether an import may name an s3:// or https:// source. Off by default: it
# makes the server fetch a URL on a caller's behalf.
DATAQ_ALLOW_REMOTE_URIS=false

# Required only for external-mode (LLM-backed) plugins. Without it, those
# plugins fall back to a deterministic fake client so the code path stays live.
# ANTHROPIC_API_KEY=sk-ant-...
# Only for a key that is not scoped to a single workspace. A personal or service
# account key acts as an identity that may reach several workspaces, so the API
# cannot tell which one a request acts in and returns a 400 without this. Find
# the id in Console -> Settings -> Workspaces; or create a workspace-scoped key
# and leave this unset.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
DATAQ_MODEL=claude-opus-5

# Serve a prebuilt frontend bundle from the API process (production).
# DATAQ_STATIC_DIR=/app/static
