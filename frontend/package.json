  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2",
    "maplibre-gl": "^6.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "react-router-dom": "^7.18.2",
    "react-vega": "^8.0.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.2.0"
